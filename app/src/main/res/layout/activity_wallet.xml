<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wallet_screen_background"
        android:orientation="vertical">

        <include layout="@layout/toolbar" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/ll_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp"
                android:visibility="invisible"
                tools:context=".ui.wallet.WalletActivity"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_wallet_hero"
                    android:elevation="6dp"
                    android:minHeight="212dp"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="top|end"
                        android:alpha="0.08"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wallet_outline"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_wallet_icon">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/wallet_icon_description"
                                    android:src="@drawable/ic_wallet_outline"
                                    app:tint="@color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.04"
                                android:text="@string/available_balance"
                                android:textAllCaps="true"
                                android:textColor="@color/wallet_hero_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_available_coin_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/wallet_available_coin_label"
                            android:textColor="@color/wallet_hero_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_available_amount"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="2dp"
                            android:autoSizeMaxTextSize="36sp"
                            android:autoSizeMinTextSize="24sp"
                            android:autoSizeStepGranularity="2sp"
                            android:autoSizeTextType="uniform"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:includeFontPadding="true"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            tools:text="2,480.00" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/wallet_balance_caption"
                            android:textColor="@color/wallet_hero_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_withdraw"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:maxLines="1"
                                android:minWidth="0dp"
                                android:text="@string/withdraw"
                                android:textAllCaps="false"
                                android:textColor="@color/wallet_hero_start"
                                android:textSize="13sp"
                                app:backgroundTint="@color/white"
                                app:cornerRadius="14dp"
                                app:rippleColor="@color/brand_blue_soft" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_transfer"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:maxLines="1"
                                android:minWidth="0dp"
                                android:text="@string/transfer_funds"
                                android:textAllCaps="false"
                                android:textColor="@color/wallet_hero_start"
                                android:textSize="13sp"
                                app:backgroundTint="@color/white"
                                app:cornerRadius="14dp"
                                app:rippleColor="@color/brand_blue_soft" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_earnings"
                    style="@style/CardViewWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/WalletSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wallet_overview" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/wallet_overview_caption"
                            android:textColor="@color/wallet_text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total_earnings"
                                    android:textColor="@color/wallet_text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/wallet_coin_label"
                                    android:textColor="@color/wallet_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tv_total_earnings"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:textColor="@color/wallet_text_primary"
                                    android:textSize="20sp"
                                    tools:text="3,250" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="50dp"
                                android:background="@color/wallet_border" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total_withdrawn"
                                    android:textColor="@color/wallet_text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/wallet_coin_label"
                                    android:textColor="@color/wallet_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tv_withdrawal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:textColor="@color/wallet_text_primary"
                                    android:textSize="20sp"
                                    tools:text="770" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_points_earned"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            tools:text="250 points" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_name"
                    style="@style/CardViewWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_referrals_title"
                            style="@style/WalletSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/my_referrals" />

                        <TextView
                            android:id="@+id/tv_member_name_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/member_name"
                            android:textColor="@color/wallet_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/wallet_text_primary"
                            android:textSize="16sp"
                            tools:text="Aarav Sharma" />

                        <TextView
                            android:id="@+id/tv_referral_code_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/referral_code"
                            android:textColor="@color/wallet_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_mobile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_wallet_pill"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.06"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp"
                            android:textColor="@color/wallet_hero_start"
                            android:textSize="14sp"
                            tools:text="SABKUCH25" />

                        <View
                            android:id="@+id/referral_divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="20dp"
                            android:background="@color/wallet_border" />

                        <TextView
                            android:id="@+id/tv_referral_heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/my_referrals"
                            android:textColor="@color/wallet_text_primary"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:id="@+id/rl_sub_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_wallet_referral"
                            android:minHeight="52dp"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="8dp"
                            android:orientation="vertical">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_referrals"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                android:visibility="gone"
                                tools:listitem="@layout/item_wallet_referral"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/tv_no_referrals"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/no_referrals_yet"
                                android:textColor="@color/wallet_text_primary"
                                android:textSize="14sp"
                                android:visibility="gone"
                                tools:visibility="visible" />

                            <LinearLayout
                                android:id="@+id/ll_referral_toggle"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_referral_toggle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/wallet_hero_start"
                                    android:textSize="13sp"
                                    tools:text="Show all 40 referrals" />

                                <ImageView
                                    android:id="@+id/iv_triangle"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginStart="4dp"
                                    android:contentDescription="@string/expand_referrals"
                                    android:padding="2dp"
                                    android:src="@drawable/baseline_expand_more_black_24dp"
                                    app:tint="@color/wallet_hero_start" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_tnc"
                    style="@style/CardViewWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_tnc_title"
                            style="@style/WalletSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/terms_conditions" />

                        <TextView
                            android:id="@+id/tv_tnc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/terms_conditions_value"
                            android:textColor="@color/wallet_text_secondary"
                            android:textSize="14sp"
                            android:linksClickable="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
