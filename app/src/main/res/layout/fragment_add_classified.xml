<?xml version="1.0" encoding="utf-8"?>
<layout>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:context=".ui.directory.AddReviewActivity">

            <TextView
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:text="@string/category" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:background="@drawable/edit_text_border">

                <Spinner
                    android:id="@+id/sp_category"
                    style="@style/SpinnerStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/SpinnerStyle" />
            </FrameLayout>

            <TextView
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:text="@string/sub_category" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:background="@drawable/edit_text_border">

                <Spinner
                    android:id="@+id/sp_sub_category"
                    style="@style/SpinnerStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/SpinnerStyle" />
            </FrameLayout>

            <TextView
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:text="@string/city" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:background="@drawable/edit_text_border">

                <Spinner
                    android:id="@+id/sp_city"
                    style="@style/SpinnerStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/SpinnerStyle" />
            </FrameLayout>

            <TextView
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:text="@string/item_location" />

            <EditText
                android:id="@+id/et_locality"
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:hint="@string/item_location_hint"
                android:inputType="textMultiLine"
                android:padding="@dimen/margin_8dp" />

            <LinearLayout
                android:id="@+id/ll_show_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bt_add_location"
                    style="@style/ButtonBlue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/margin_16dp"
                    android:paddingRight="@dimen/margin_16dp"
                    android:text="@string/show_location" />

                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="@string/err" />
            </LinearLayout>

            <TextView
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:text="@string/title" />

            <EditText
                android:id="@+id/et_title"
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:hint="@string/title"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:padding="@dimen/margin_8dp" />

            <TextView
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:text="@string/details" />

            <EditText
                android:id="@+id/et_about"
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:hint="@string/details"
                android:imeOptions="actionNext"
                android:inputType="textMultiLine"
                android:lines="2"
                android:padding="@dimen/margin_8dp" />

            <TextView
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:text="@string/rate" />

            <EditText
                android:id="@+id/et_rate"
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:hint="@string/rate"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:padding="@dimen/margin_8dp" />

            <TextView
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:text="@string/discount" />

            <EditText
                android:id="@+id/et_discount"
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:hint="@string/discount"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:padding="@dimen/margin_8dp" />

            <TextView
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:text="@string/how_to_contact" />

            <EditText
                android:id="@+id/et_contact"
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_4dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:hint="@string/contact"
                android:inputType="textMultiLine"
                android:padding="@dimen/margin_8dp" />

            <TextView
                android:id="@+id/tv_add_picture"
                style="@style/TextViewBlackHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginTop="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:paddingBottom="@dimen/margin_16dp"
                android:text="@string/add_photos" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_16dp"
                android:layout_marginRight="@dimen/margin_16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_add_picture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_add_picture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="@drawable/dotted_shape_rad4"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/margin_4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_margin="@dimen/margin_16dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ico_add_photo" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</layout>