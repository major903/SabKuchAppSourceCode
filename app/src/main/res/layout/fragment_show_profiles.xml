<?xml version="1.0" encoding="utf-8"?>
<layout>

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ViewStub
            android:id="@+id/vs_no_profiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout="@layout/layout_no_profiles" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:context=".ui.matrimonial.ShowProfilesFragment">

                    <com.yuyakaido.android.cardstackview.CardStackView
                        android:id="@+id/csv_profile"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_432dp"
                        android:layout_marginBottom="@dimen/fab_half_margin"
                        tools:listitem="@layout/fragment_show_profiles_list_item" />

                    <!--<ImageView
                        android:id="@+id/iv_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/fab_half_margin"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/profile_image"
                        android:maxHeight="@dimen/margin_480dp"
                        tools:src="@drawable/whynot" />-->

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab_like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/margin_96dp"
                        android:src="@drawable/baseline_thumb_up_white_24"
                        app:layout_anchor="@+id/csv_profile"
                        app:layout_anchorGravity="bottom|right" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab_dislike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_96dp"
                        android:src="@drawable/baseline_thumb_down_white_24"
                        app:backgroundTint="@color/red"
                        app:layout_anchor="@+id/csv_profile"
                        app:layout_anchorGravity="left|bottom" />

                </androidx.coordinatorlayout.widget.CoordinatorLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_16dp"
                    android:layout_marginLeft="@dimen/margin_16dp"
                    android:layout_marginEnd="@dimen/margin_16dp"
                    android:layout_marginRight="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_name"
                        style="@style/TextViewBlackHeading2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_distance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_marital_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_mother_tongue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_occupation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_qualification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_annual_income"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_body_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_complexion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_religion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_caste"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_gothra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_nakshatra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_dosham"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_food_habit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_drinking_habit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_smoking_habit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/margin_8dp"

                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_physical_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_living_with"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_own_car"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />

                    <TextView
                        android:id="@+id/tv_own_house"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8dp"
                        android:textSize="@dimen/text_size_17"
                        tools:text="@string/err" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</layout>