                    android:layout_below="@+id/tv_age"
                    android:layout_marginTop="@dimen/margin_8dp"
                    app:bar_color="@color/grey"
                    app:bar_highlight_color="@color/colorPrimary"
                    app:data_type="_integer"
                    app:gap="1"
                    app:left_thumb_color="@color/colorPrimary"
                    app:left_thumb_color_pressed="@color/colorPrimary"
                    app:max_value="99"
                    app:min_value="18"
                    app:right_thumb_color="@color/colorPrimary"
                    app:right_thumb_color_pressed="@color/colorPrimary"
                    app:steps="1" />

                <TextView
                    android:id="@+id/textViewAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/seekBarAge"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:layout_marginRight="@dimen/dp_four"
                    android:text="18-40"
                    android:textColor="@android:color/black" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp">

                <TextView
                    android:id="@+id/tv_height"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/height_range"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/sp_eighteen" />

                <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                    android:id="@+id/seekBarHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_height"
                    android:layout_marginTop="@dimen/margin_8dp"
                    app:bar_color="@color/grey"
                    app:bar_highlight_color="@color/colorPrimary"
                    app:data_type="_integer"
                    app:gap="1"
                    app:left_thumb_color="@color/colorPrimary"
                    app:left_thumb_color_pressed="@color/colorPrimary"
                    app:max_value="200"
                    app:min_value="0"
                    app:right_thumb_color="@color/colorPrimary"
                    app:right_thumb_color_pressed="@color/colorPrimary"
                    app:steps="1" />

                <TextView
                    android:id="@+id/textViewHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/seekBarHeight"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:layout_marginRight="@dimen/dp_four"
                    android:text="3-12"
                    android:textColor="@android:color/black" />

            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/rl_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp">

                <TextView
                    android:id="@+id/tv_weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weight_range"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/sp_eighteen" />

                <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                    android:id="@+id/seekBarWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_weight"
                    android:layout_marginTop="@dimen/margin_8dp"
                    app:bar_color="@color/grey"
                    app:bar_highlight_color="@color/colorPrimary"
                    app:data_type="_integer"
                    app:gap="1"
                    app:left_thumb_color="@color/colorPrimary"
                    app:left_thumb_color_pressed="@color/colorPrimary"
                    app:max_value="200"
                    app:min_value="10"
                    app:right_thumb_color="@color/colorPrimary"
                    app:right_thumb_color_pressed="@color/colorPrimary"
                    app:steps="1" />

                <TextView
                    android:id="@+id/textViewWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/seekBarWeight"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:layout_marginRight="@dimen/dp_four"
                    android:text="10-60"
                    android:textColor="@android:color/black" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp">

                <TextView
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/distance_range"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/sp_eighteen" />

                <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                    android:id="@+id/seekBarDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_distance"
                    android:layout_marginTop="@dimen/margin_8dp"
                    app:bar_color="@color/grey"
                    app:bar_highlight_color="@color/colorPrimary"
                    app:data_type="_integer"
                    app:gap="1"
                    app:left_thumb_color="@color/colorPrimary"
                    app:left_thumb_color_pressed="@color/colorPrimary"
                    app:max_value="20000"
                    app:min_value="0"
                    app:right_thumb_color="@color/colorPrimary"
                    app:right_thumb_color_pressed="@color/colorPrimary"
                    app:steps="1" />

                <TextView
                    android:id="@+id/textViewDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/seekBarDistance"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/margin_4dp"
                    android:layout_marginRight="@dimen/dp_four"
                    android:text="18-40"
                    android:textColor="@android:color/black" />

            </RelativeLayout>


            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:background="@color/colorPrimary"
                android:onClick="@{preferenceFragment::btnUpdateClick}"
                android:text="@string/update"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </ScrollView>
</layout>