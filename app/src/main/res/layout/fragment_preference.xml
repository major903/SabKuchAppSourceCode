                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/dp_four"
                    android:text="10-60"
                    android:textColor="@android:color/black" />

            </RelativeLayout>

            <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                android:id="@+id/seekBarWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:bar_color="@color/grey"
                app:bar_highlight_color="@color/colorPrimary"
                app:data_type="_integer"
                app:gap="1"
                app:left_thumb_color="@color/colorPrimary"
                app:left_thumb_color_pressed="@color/colorPrimary"
                app:max_value="200"
                app:min_value="10"
                app:right_thumb_color="@color/colorPrimary"
                app:right_thumb_color_pressed="@color/colorPrimary"
                app:steps="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:text="@string/distance_range"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/sp_eighteen" />

                <TextView
                    android:id="@+id/textViewDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/dp_four"
                    android:text="18-40"
                    android:textColor="@android:color/black" />

            </RelativeLayout>

            <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                android:id="@+id/seekBarDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:bar_color="@color/grey"
                app:bar_highlight_color="@color/colorPrimary"
                app:data_type="_integer"
                app:gap="1"
                app:left_thumb_color="@color/colorPrimary"
                app:left_thumb_color_pressed="@color/colorPrimary"
                app:max_value="1000"
                app:min_value="0"
                app:right_thumb_color="@color/colorPrimary"
                app:right_thumb_color_pressed="@color/colorPrimary"
                app:steps="1" />
        </LinearLayout>


        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_16dp"
            android:background="@color/colorPrimary"
            android:text="Update"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>