<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="cropImageActivity"
            type="vedam.subkuch.ui.cropImage.CropImageActivity" />
    </data>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@color/colorPrimary"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:popupTheme="@style/AppTheme.PopupOverlay">

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <com.canhub.cropper.CropImageView
        android:id="@+id/imageViewCrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomLayout"
        android:layout_below="@+id/toolbar"
        app:cropGuidelines="on"
        app:cropGuidelinesColor="#66ffffff"
        app:cropGuidelinesThickness="1dp"
        app:cropBorderLineColor="#ffffff"
        app:cropBorderLineThickness="1dp"
        app:cropFixAspectRatio="true" />

    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="@dimen/dp_eight"
        android:background="@color/white"
        style="?android:attr/buttonBarStyle"
        android:weightSum="2">

        <Button
            android:id="@+id/buttonCrop"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_eight"
            android:onClick="@{cropImageActivity::buttonCropClick}"
            android:layout_marginEnd="@dimen/dp_four"
            android:layout_weight="1"
            android:padding="@dimen/dp_eight"
            android:text="@string/Crop"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_eighteen" />

        <Button
            android:id="@+id/buttonDiscard"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_four"
            android:layout_marginTop="@dimen/dp_eight"
            android:onClick="@{cropImageActivity::buttonDiscardClick}"
            android:layout_weight="1"
            android:padding="@dimen/dp_eight"
            android:text="@string/discard"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_eighteen" />
    </LinearLayout>

</RelativeLayout>
</layout>
