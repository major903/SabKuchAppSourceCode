<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_4dp"
    android:layout_marginBottom="@dimen/margin_4dp"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="@dimen/margin_16dp">

    <TextView
        android:id="@+id/tv_estate_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_estate_type_chip"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="10dp"
        android:paddingTop="@dimen/margin_4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="@dimen/margin_4dp"
        android:textColor="@color/form_text_secondary"
        android:textSize="12sp"
        tools:text="Residential Plot" />

    <TextView
        android:id="@+id/tv_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_8dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/form_text_primary"
        android:textSize="16sp"
        tools:text="Near RTC Complex, Anakapalli" />

    <TextView
        android:id="@+id/tv_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp"
        android:textColor="@color/form_text_secondary"
        android:textSize="14sp"
        tools:text="200 sq.yd residential plot, clear title, east facing" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:background="#14000000" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:layout_toStartOf="@+id/ib_call"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/form_text_primary"
                android:textSize="14sp"
                tools:text="Ramesh Kumar" />

            <TextView
                android:id="@+id/tv_mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                tools:text="9876543210" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ib_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_icon"
            android:backgroundTint="@color/colorPrimary"
            android:contentDescription="@string/call"
            android:padding="@dimen/margin_8dp"
            app:srcCompat="@drawable/ic_job_call"
            app:tint="@color/white" />
    </RelativeLayout>
</LinearLayout>
