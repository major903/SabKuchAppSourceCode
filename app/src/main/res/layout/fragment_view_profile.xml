<?xml version="1.0" encoding="utf-8"?>
<layout>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_16dp">

            <android.support.design.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:context=".ui.matrimonial.ShowProfilesFragment">

                <android.support.v7.widget.CardView
                    android:id="@+id/cv_image"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_432dp"
                    android:layout_marginBottom="@dimen/margin_28dp"
                    app:cardBackgroundColor="@color/grey"
                    app:cardCornerRadius="8dp"
                    app:cardPreventCornerOverlap="false"
                    app:cardUseCompatPadding="true">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/iv_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:riv_corner_radius="8dp"
                        tools:src="@drawable/placeholder" />

                </android.support.v7.widget.CardView>

                <android.support.design.widget.FloatingActionButton
                    android:id="@+id/fab_dislike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/baseline_thumb_down_white_24"
                    app:backgroundTint="@color/red"
                    app:layout_anchor="@+id/cv_image"
                    app:layout_anchorGravity="center_horizontal|bottom" />

            </android.support.design.widget.CoordinatorLayout>

            <TextView
                android:id="@+id/tv_name"
                style="@style/TextViewBlackHeading2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8dp"
                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_marital_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_mother_tongue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_occupation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_qualification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_annual_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_body_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_complexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_religion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_caste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_gothra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_nakshatra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_dosham"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_food_habit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_drinking_habit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_smoking_habit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_physical_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/margin_8dp"

                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_living_with"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8dp"
                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_own_car"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8dp"
                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_own_house"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8dp"
                android:textSize="@dimen/text_size_17"
                tools:text="@string/err" />
        </LinearLayout>
    </ScrollView>
</layout>