<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/margin_8dp"
        android:layout_toLeftOf="@+id/ib_direction"
        android:textColor="@color/black"
        android:textSize="14sp"
        tools:text="@string/err" />

    <ImageButton
        android:id="@+id/ib_direction"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignTop="@+id/tv_address"
        android:layout_alignBottom="@+id/tv_address"
        android:layout_alignParentRight="true"
        android:background="@color/transparent"
        android:tint="@color/black"
        app:srcCompat="@drawable/ic_baseline_directions_24" />

</RelativeLayout>