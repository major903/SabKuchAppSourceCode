    <com.google.android.material.card.MaterialCardView
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_8dp"
        android:layout_marginVertical="@dimen/margin_4dp"
        android:elevation="@dimen/margin_4dp"
        android:padding="@dimen/margin_8dp"
        app:cardBackgroundColor="#e6e6e6">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/message_row_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_8dp">

            <TextView
                android:id="@+id/message_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/margin_4dp"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="300dp"
                tools:text="dvs" />

            <TextView
                android:id="@+id/message_text_date"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:gravity="center_vertical"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintRight_toLeftOf="@+id/chat_row_sent"
                app:layout_constraintTop_toBottomOf="@+id/message_text"
                tools:text="02/04/1993" />

            <ImageView
                android:id="@+id/chat_row_sent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:paddingStart="@dimen/margin_8dp"
                android:src="@drawable/ic_done_black_18dp"
                android:visibility="visible"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/message_text" />

