<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:openDrawer="start">

        <include
            android:id="@+id/main"
            layout="@layout/app_bar_show_profiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="@dimen/navigation_drawer_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            app:headerLayout="@layout/nav_header_home"
            app:itemBackground="@drawable/bg_drawer_navigation_item"
            app:itemIconTint="@null"
            app:itemIconSize="32dp"
            app:itemIconPadding="16dp"
            app:itemTextAppearance="@style/NavDrawerItemTextAppearance"
            app:itemHorizontalPadding="@dimen/margin_24dp"
            app:itemTextColor="@color/drawer_item_text_tint"
            app:itemVerticalPadding="@dimen/margin_12dp"
            />

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>
