<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        android:layout_margin="@dimen/margin_8dp"
        app:cardCornerRadius="@dimen/margin_4dp"
        app:cardElevation="@dimen/margin_2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:background="@color/white"
            android:orientation="vertical">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/iv_product"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/margin_8dp"
                android:scaleType="centerCrop"
                app:riv_oval="false"
                tools:src="@drawable/grey" />

            <TextView
                android:id="@+id/tv_brand"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:textColor="@color/black"
                android:paddingHorizontal="@dimen/margin_8dp"
                android:textSize="@dimen/text_size_14"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:textStyle="bold"
                android:paddingHorizontal="@dimen/margin_8dp"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_vendor_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/margin_8dp"
                android:textSize="@dimen/text_size_14"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_kms_away"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/margin_8dp"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_14"
                tools:text="@string/err" />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/margin_8dp"
                android:textColor="@color/reddish_brown"
                android:textSize="@dimen/text_size_16"
                tools:text="@string/err" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</layout>