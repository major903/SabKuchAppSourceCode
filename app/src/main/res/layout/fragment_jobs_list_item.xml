<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/myshape"
    android:orientation="vertical"
    android:padding="@dimen/margin_8dp">

    <TextView
        android:id="@+id/tv_organisation"
        style="@style/TextViewBlackHeading"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        tools:text="@string/err" />

    <TextView
        android:id="@+id/tv_deals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="@string/err" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4dp">

        <TextView
            android:id="@+id/tv_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/margin_8dp"
            android:layout_toLeftOf="@+id/ib_direction"
            android:textColor="@color/black"
            android:textSize="14sp"
            tools:text="@string/err" />

        <ImageButton
            android:id="@+id/ib_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@color/transparent"
            android:src="@drawable/baseline_directions_black_24" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tvDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        tools:text="@string/err" />

    <TextView
        android:id="@+id/tv_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_8dp"
        tools:text="@string/err" />

    <TextView
        android:id="@+id/tv_contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_8dp"
        tools:text="@string/err" />

</LinearLayout>