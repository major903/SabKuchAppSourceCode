<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/margin_16dp">

        <TextView
            android:id="@+id/tv_pin_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/red"
            android:visibility="invisible"
            tools:text="@string/err"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/TextViewBlackHeading2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            tools:text="@string/enter_pin" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_32dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_pin1"
                style="@style/PinStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/margin_8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="numberPassword"
                android:maxLength="1"
                android:padding="@dimen/margin_8dp"
                android:singleLine="true">

                <requestFocus />
            </EditText>

            <EditText
                android:id="@+id/et_pin2"
                style="@style/PinStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/margin_8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="numberPassword"
                android:maxLength="1"
                android:padding="@dimen/margin_8dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/et_pin3"
                style="@style/PinStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/margin_8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="numberPassword"
                android:maxLength="1"
                android:padding="@dimen/margin_8dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/et_pin4"
                style="@style/PinStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="numberPassword"
                android:maxLength="1"
                android:padding="@dimen/margin_8dp"
                android:singleLine="true" />
        </LinearLayout>

        <Button
            android:id="@+id/bt_submit"
            style="@style/ButtonBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/submit" />

        <TextView
            android:id="@+id/tv_warning"
            style="@style/TextViewBlackHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/margin_64dp"
            android:text="@string/warning" />

        <TextView
            android:id="@+id/tv_warning2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/margin_16dp"
            android:gravity="center_horizontal"
            android:text="@string/warning_message" />
    </LinearLayout>
</layout>